# Copy this file to .env.local and fill in the values.

# ---------- AI copywriting (free) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional free fallback: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- AI images (free) ----------
# Pollinations works with NO key (text-to-image only, ~1 image every 45 s).
# For best quality add a FREE pollen key from https://enter.pollinations.ai - it unlocks
# reference-image models that put YOUR real product photo into the lifestyle scene.
POLLINATIONS_KEY=
# Free-tier reference-image models: kontext (best) or klein (cheaper, more images/day)
POLLINATIONS_REF_MODEL=kontext
# Free-tier text-to-image model used when there is no product photo
POLLINATIONS_MODEL=zimage
POLLINATIONS_GEN_URL=https://gen.pollinations.ai/image/
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt/
# Gemini image editing. OFF by default because it is billed if your Google key has billing enabled.
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional free fallback (Hugging Face token with "inference" permission): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------- Reels ----------
FFMPEG_PATH=ffmpeg
# Optional: absolute path to an mp3 used as background music for reels
REEL_MUSIC_PATH=

# ---------- Facebook + Instagram (Meta Graph API) ----------
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
# Long-lived Page access token (see README)
META_PAGE_ACCESS_TOKEN=
# Optional - auto-detected from the Page if left empty
META_IG_USER_ID=

# ---------- Pinterest ----------
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Trial apps must use https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5

# ---------- Optional ----------
# Public URL of this app (e.g. a cloudflared/ngrok tunnel). If empty, Instagram images
# are hosted via unpublished Facebook Page photos instead.
PUBLIC_BASE_URL=
